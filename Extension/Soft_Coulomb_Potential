def update(p,I):                      #n is dimension of the path , i is the number of loops to complete , p is the inital path                                                       
    A=0
    n=len(p)
    for i in range(0,I):
        for j in range(0,n):
            p_old=p[j] 
        
            if j==0:
                Sj_old=S(p,j+1)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS1=S(p,j+1)-Sj_old
                A = A+1
                if dS1 > 0  and np.exp(-dS1) < np.random.uniform(0, 1):
                    A = A-1
                    p[j]=p_old

            
            if 0<j<n-1: 
                Sj_old1=S(p,j+1)
                Sj_old2=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS1=S(p,j+1)
                dS2=S(p,j)
                dS=(dS1+dS2)-(Sj_old1+Sj_old2)
                A = A+1 
                if dS > 0 and np.exp(-dS) < np.random.uniform(0, 1):
                    A = A-1 
                    p[j]=p_old
            
        
            if j== n-1: 
                Sj_old=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS2=S(p,j)-Sj_old
                A = A+1
                if dS2 > 0 and np.exp(-dS2) < np.random.uniform(0, 1):
                    A = A - 0
                    p[j]=p_old
                    

            if p[0] != p[n-1]:
                p[0]= p[n-1]
     
    return p                                                              #Change to A/N when you want to test vals of eps                             

 


def f(x):                                                   #Anlytic solution from Schrodinger 
    return 4*np.exp(-2*x)*x**2                              #DOUBLE CHECK AS THIS IS RADIAL PROBABILIY 

Analytic_x_vals=np.arange(0,12.1,0.001)

def MetroplisAv(x):                                      
    paths=np.zeros(shape=(N_cf,N))                            
    p=update(x,10*N_cor)                                     #Thermalising 
       
    for l in range(0,N_cf-1):
        p=update(p,N_cor)
        paths[l,:]=p

    return(paths)


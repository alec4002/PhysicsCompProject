alpha=0.75

def V_coulomb(x):
    V=1/x 
    return V

def V_soft_Coulomb(x):
    V=1/((x**2+alpha**2)**0.5)
    return V

def V_Morse(x):
    V=(1/alpha)*(np.exp(-2*x/(alpha*2**(1/2)))-2*np.exp(-x/(alpha*(2**(1/2)))))
    return V

def V_MsC(x):
    if x>0:
        V= -1/(x**2+alpha**2)
    if x <= 0:
        V=(1/alpha)*(np.exp(-2*x/(alpha*2**(1/2)))-2*np.exp(-x/(alpha*(2**(1/2)))))
    return V

x_values=np.arange(-12.1,12.1,0.01)

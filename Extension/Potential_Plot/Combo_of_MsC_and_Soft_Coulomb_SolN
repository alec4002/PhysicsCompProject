def f(y):
    z=2*a*np.exp(-alpha_prime*y)
    return (np.exp(-z/2)*z)**2

Analytic_x_vals=np.arange(-12,12.1,0.001)

def fC(x):                                                   #Anlytic solution from Schrodinger 
    return 4*np.exp(-2*x)*x**2                              #DOUBLE CHECK AS THIS IS RADIAL PROBABILIY 

Analytic_x_valsC=np.arange(0,12.1,0.001) 

def fcombo(x):
    y=np.array([])
    for i in range(0,len(x)):
        if x[i]>0:
            y=np.append(y,fC(x[i]))
        if x[i] <=0:
            y=np.append(y,f(x[i]))
    return y 


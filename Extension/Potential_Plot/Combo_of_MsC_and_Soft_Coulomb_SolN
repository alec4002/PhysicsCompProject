w=(1/alpha_prime)*(2*D)**0.5
E_0=-D-(alpha_prime*(D/2)**0.5)-(1/8)*(alpha_prime**2)
b=(1/alpha_prime)*(-2*E_0)**0.5
Norm=(alpha_prime*(2*w-1))/(scipy.special.gamma(2*w))

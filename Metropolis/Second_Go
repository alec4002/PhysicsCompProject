def f(x):                                       #Anlytic solution from Schrodinger 
    return (np.exp((-x**2)/2)/((np.pi)**(1/4)))**2

Analytic_x_vals=np.arange(-5,5.1,0.001)

def MetroplisAv(n):                                      
    paths=np.zeros(shape=(N_cf,N))
                            
    for i in range(0,5*N_cor):
        p=update(n)                                     #Thermalising 
       
    for l in range(0,N_cf-1):
        for k in range(0, N_cor):
            p=update(n)
        paths[l,:]=p

    return(np.histogram(paths,bins=100,density=True))

 

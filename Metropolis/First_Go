#Defining the Harmonic potential 
def V(x):
    V=1/2*(x**2)
    return V

#Defining the action -NB-For my Metropolis, it is more useful to define the action per segment, and the count for the summation in the update step. 
def S(x,j):   
    S = (m/2*a)*(((x[j]-x[j-1]))**2)+a*V((x[j-1]))   # +x[j-1]))
    return S

#Defining the updating algorithm. 
def update(x):

    A=0
    n=N-1                                                                #n is the index of the path 
    p=np.zeros(shape=(1,N))
    p=p[0,:]
    p[0]=p[n]=x
                                                      
    for j in range(0,N):
        p_old=p[j] 
        
        if 0<j<N-2: 
            Sj_old=S(p,j)
            p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
            dS1=S(p,j)-Sj_old
            dS2=S(p,j+1)-Sj_old
            if dS1 > 0 and dS2 > 0 and np.exp(-dS1) < np.random.uniform(0, 1) and np.exp(-dS2) < np.random.uniform(0, 1):
                A=A+1
                p[j]=p_old
    
    return p                    #Change to A when you want to test vals of eps                             


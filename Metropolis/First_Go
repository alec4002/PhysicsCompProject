#Energy of the path is just sum of S along the path 
#Plot path vs enegry. Do Ns until it levels 

def E_tot(x):
    E=0
    for i in range(1,len(x)):
        E += E + S(x,i)
    return E 

#Making a func to plot E vs no of paths
def Graph(N_cor):
    x=np.arange(0,N,1)                  #Empty path to begin 
    E=np.arange(0,N_cor)                #Empty energy vals to replace
    for i in range(0,N_cor):
        update(x)                       #sweeping the lattice
        E[i]=E_tot(x)                   #Calculating total energy 
        Steps=np.arange(0,N_cor)        #Keeping track of corresponding sweep number
    plt.figure()
    plt.xlabel('N_cor')
    plt.ylabel('Energy')
    plt.plot(Steps,E)
    plt.show()


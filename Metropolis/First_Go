#Defining the Harmonic potential 
def V(x):
    V=1/2*(x**2)
    return V

#Defining the action -NB-For my Metropolis, it is more useful to define the action per segment, and the count for the summation in the update step. 
def S(x,j):   
    S = (m/2)*(((x[j]-x[j-1])/a)**2)+V((x[j]+x[j-1]))
    return S

#Defining the updating algorithm. 
def update(x):
    A=0  

    
                                                              
    for j in range(0,N):
        x_old=x[j] 
        if j==0:
            Sj_old=S(x,j+1)
            x[j]=x[j]+(np.random.uniform(-eps, eps)) 
            dS= S(x,j+1)-Sj_old 
            if dS > 0 and np.exp(-dS) < np.random.uniform(0, 1):
                    
                x[j]=x_old
        if j==N-1:
            Sj_old=S(x,j)
            x[j]=x[j]+(np.random.uniform(-eps, eps)) 
            dS= S(x,j)-Sj_old 
            if dS > 0 and np.exp(-dS) < np.random.uniform(0, 1):
                
                x[j]=x_old

        if 0<j<N-2: 
            Sj_old=S(x,j)
            x[j]=x[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
            dS1=S(x,j)-Sj_old
            dS2=S(x,j+1)-Sj_old
            if dS1 > 0 and dS2 > 0 and np.exp(-dS1) < np.random.uniform(0, 1) and np.exp(-dS2) < np.random.uniform(0, 1):
                
                x[j]=x_old
    

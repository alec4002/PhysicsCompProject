#defining constants 
m=1
N_cor=500  
N_cf=100    #Number that needs to big enough to ensure probabilities behave  
N=20        #Spatial Points
a=1         #a is the time step, 4 temporal points, N spatial
eps=1.6       #Range from which we will pick a random number. This is tuned so as to cause a 40%-60% acceptance rate. 
Q=(1/(2*np.pi*a))**(N/2)            #Normalising from Lepage

#Defining the Harmonic potential 
def V(x):
    V=1/2*(x**2)
    return V

#Defining the action -NB-For my Metropolis, it is more useful to define the action per segment, and the count for the summation in the update step. 
def S(x,j):   
    S = (m/2*a)*(((x[j]-x[j-1]))**2)+a*V((x[j-1]))   # +x[j-1]))
    return S

#Defining the updating algorithm. 
x=np.zeros(shape=(1,N))          #Take this out see if i can make it so p i saved                                    
x=x[0,:]

def update(p,I):                      #n is dimension of the path , i is the number of loops to complete                                                         
    A=0
    n=len(p)
    for i in range(0,I):
        for j in range(0,N):
            p_old=p[j] 
        
            if j==0:
                Sj_old=S(p,j+1)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS1=S(p,j+1)-Sj_old
                p[0]=p[n-1]
                A = A+1
                if dS1 > 0  and np.exp(-dS1) < np.random.uniform(0, 1):
                    A = A-1
                    p[j]=p_old

            
            if 0<j<n-1: 
                Sj_old1=S(p,j+1)
                Sj_old2=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS1=S(p,j+1)
                dS2=S(p,j)
                dS=(dS1+dS2)-(Sj_old1+Sj_old2)
                A = A+1 
                if dS > 0 and np.exp(-dS) < np.random.uniform(0, 1):
                    A = A-1 
                    p[j]=p_old
            
        
            if j== n-1: 
                Sj_old=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS2=S(p,j)-Sj_old
                p[n-1]=p[0]
                A = A+1
                if dS2 > 0 and np.exp(-dS2) < np.random.uniform(0, 1):
                    A = A - 0
                    p[j]=p_old
            
    return A/N            




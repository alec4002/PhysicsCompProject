def V_coulomb(x):
    V=-1/x 
    return V


def V_MsC_1(x):
    if x>0:
        denominator=(x**2+0.05**2)
        V= -(denominator)**(-0.5)
    if x <= 0:
        V=(1/0.05)*(np.exp(-2*x/(0.05*2**0.5))-2*np.exp(-x/(0.05*2**0.5)))
    return V

def V_MsC_2(x):
    if x>0:
        denominator=(x**2+0.4**2)
        V= -(denominator)**(-0.5)
    if x <= 0:
        V=(1/0.4)*(np.exp(-2*x/(0.4*2**0.5))-2*np.exp(-x/(0.4*2**0.5)))
    return V

def V_MsC_3(x):
    if x>0:
        denominator=(x**2+0.2**2)
        V= -(denominator)**(-0.5)
    if x <= 0:
        V=(1/0.2)*(np.exp(-2*x/(0.2*2**0.5))-2*np.exp(-x/(0.2*2**0.5)))
    return V


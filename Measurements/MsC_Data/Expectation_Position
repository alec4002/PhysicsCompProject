#Defining the potential 
def V(x):
    if x>0:
        denominator=(x**2+alpha**2)
        V= -(denominator)**(-0.5)
    if x <= 0:
        V=(1/alpha)*(np.exp(-2*x/(alpha*2**0.5))-2*np.exp(-x/(alpha*2**0.5)))
    return V

#Defining the action -NB-For my Metropolis, it is more useful to define the action per segment, and the count for the summation in the update step. 
def S(x,j):   
    S = (m/2*a)*(((x[j]-x[j-1]))**2)+a*V((x[j-1])) 
    return S

def Expected_position(q):
    k=x_coords(q)*(counts(q)[0])
    return np.average(k)


def counts(q):
    counts, bins= np.histogram(q.ravel(),bins=np.arange(-5,10.1,0.05),density=True)
    return counts,bins 

def x_coords(q):
    n=np.array([])
    p=(counts(q)[1])
    for i in range(1,len(p)):
        k=(p[i]+p[i-1])/2
        n=np.append(n,k)
    return n 


def bootstrap(x):
    bst=np.array([])
    for i in range(0,len(x)):
        m=np.random.randint(0, len(x))
        bst=np.append(bst,x[m])
    return bst 

def binning(q,binsize):
    ensemble=np.array([])
    for j in np.arange(0,len(q),binsize):
        g=0
        for i in range(0,binsize):
            g= g + q[i+j]
        ensemble=np.append(ensemble, g/binsize)
    return ensemble


def counts(q):
    counts, bins= np.histogram(q.ravel(),bins=np.arange(-2,5.1,0.05),density=True)
    return counts,bins 

def x_coords(q):
    n=np.array([])
    p=(counts(q)[1])
    for i in range(1,len(p)):
        k=(p[i]+p[i-1])/2
        n=np.append(n,k)
    return n 


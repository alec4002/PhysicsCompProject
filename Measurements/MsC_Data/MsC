#Functional code 

def Expected_position(q):
    avs=np.array([])
    for i in range(0,len(q)):
        av=np.average(q[i,:])
        avs=np.append(avs,av)
    
    return avs

def Expected_Energy(q):
    avs=np.array([])
    for i in range(0,len(q)):
        k=q[i,:]
        e=np.array([])
        for j in range(1,len(k)):
            S = (m/2*a)*(((k[j]-k[j-1]))**2)+a*V((k[j-1]))
            e = np.append(e,S)
        avs=np.append(avs,np.average(e))        
    return  avs


def bootstrap(x):
    bst=np.array([])
    for i in range(0,len(x)):
        m=np.random.randint(0, len(x))
        bst=np.append(bst,x[m])
    return bst 

def binning(q,binsize):
    ensemble=np.array([])
    for j in np.arange(0,len(q),binsize):
        g=0
        for i in range(0,binsize):
            g= g + q[i+j]
        ensemble=np.append(ensemble, g/binsize)
    return ensemble


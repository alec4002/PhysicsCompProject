def update(p,I):                      #n is dimension of the path , i is the number of loops to complete , p is the inital path                                                       
    A=0
    n=len(p)
    for i in range(0,I):
        for j in range(0,n):
            p_old=p[j] 
        
            if j==0:
                Sj_old=S(p,j+1)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function generates random no between -eps and eps
                dS1=S(p,j+1)-Sj_old
                A = A+1
                if dS1 > 0  and np.exp(-dS1) < np.random.uniform(0, 1):
                    A = A-1
                    p[j]=p_old

            
            if 0<j<n-1: 
                Sj_old1=S(p,j+1)
                Sj_old2=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS1=S(p,j+1)
                dS2=S(p,j)
                dS=(dS1+dS2)-(Sj_old1+Sj_old2)
                A = A+1 
                if dS > 0 and np.exp(-dS) < np.random.uniform(0, 1):
                    A = A-1 
                    p[j]=p_old
            
        
            if j== n-1: 
                Sj_old=S(p,j)
                p[j]=p[j]+(np.random.uniform(-eps, eps))                     #This function form numpy generates random no between -eps and eps
                dS2=S(p,j)-Sj_old
                A = A+1
                if dS2 > 0 and np.exp(-dS2) < np.random.uniform(0, 1):
                    A = A - 0
                    p[j]=p_old
                    

            if p[0] != p[n-1]:
                p[0]= p[n-1]
     
    return p                                                              #Change to A/N when you want to test vals of eps                             

 

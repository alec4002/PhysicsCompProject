def av_x(x):                                 #Average position of a path 
    E=np.array([])
    for i in range(0,len(x)-1):
        E=np.append(E,np.average(x))
    av= np.average(E)
    return av

def av_x_square(x):                                 #Average position squared of a path 
    E=np.array([])
    for i in range(0,len(x)-1):
        E=np.append(E,np.average(x*x))
    av_square=np.average(E)
    return av_square


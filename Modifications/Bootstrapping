#Bootstrapping makes a statistically uncorrelated copy of a configuration of measuremnts. This saves us from repeating data collection. 

def bootstrap(x):
    bst=np.array([])
    for i in range(0,len(x)-1):
        m=np.random.randint(0, len(x))
        bst=np.append(bst,x[m])
    return bst 

